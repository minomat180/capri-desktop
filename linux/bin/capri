#!/bin/sh
# Start Capri (the service, which runs the overlay). Logs: ~/.local/state/capri/capri.log
# Usage: capri [--dev] [--no-shell]        (stop it: capri-ctl quit)
root=$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)
state=${XDG_STATE_HOME:-$HOME/.local/state}/capri
mkdir -p "$state"
unset ELECTRON_RUN_AS_NODE
if [ -t 1 ]; then
  exec node "$root/linux/daemon/main.js" "$@"
fi
exec node "$root/linux/daemon/main.js" "$@" >> "$state/capri.log" 2>&1
