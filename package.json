{
  "name": "capri-desktop",
  "version": "0.3.1",
  "description": "Capri, the desktop companion who narrates what Claude Code is doing, ported to Linux (Wayland, mango) and macOS.",
  "author": "mochiiwuff",
  "repository": "github:minomat180/capri-desktop",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "linux/bin/capri",
    "demo": "node scripts/demo.js",
    "hooks:install": "node scripts/install-hooks.js",
    "hooks:uninstall": "node scripts/install-hooks.js --uninstall",
    "electron:start": "electron .",
    "electron:dev": "electron . --dev",
    "electron:dist": "electron-builder --win"
  },
  "keywords": [
    "claude-code",
    "desktop-pet",
    "electron",
    "cyberpunk",
    "edgerunners"
  ],
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0"
  },
  "build": {
    "appId": "capri.desktop",
    "productName": "Capri",
    "files": [
      "src/**",
      "assets/**",
      "hooks/**",
      "scripts/**",
      "package.json",
      "LICENSE"
    ],
    "asarUnpack": [
      "hooks/**",
      "src/main/windows.ps1"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capri.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "shortcutName": "Capri",
      "artifactName": "Capri-Setup-${version}.${ext}"
    }
  },
  "optionalDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "contributors": [
    "minomat180 (Linux and macOS ports)"
  ]
}
